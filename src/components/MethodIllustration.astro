---
interface Props {
 kind: 'hero' | 'representations' | 'screening' | 'binding-affinity' | 'docking';
 eager?: boolean;
 compact?: boolean;
}
const {kind,eager=false,compact=false}=Astro.props;
const base=import.meta.env.BASE_URL+'illustrations/editorial/';
const hero=kind==='hero';
const asset=kind+(compact?'-detail':'');
---
<div class:list={['method-illustration',{'illustration-hero':hero,'illustration-compact':compact}]} aria-hidden="true">
 {kind==='docking'?<img class="docking-illustration" src={import.meta.env.BASE_URL+'paper-figures/etdock-pose-detail.webp'} width="840" height="460" alt="" loading={eager?'eager':'lazy'} decoding="async"/>:<img src={base+asset+'.webp'} srcset={`${base+asset}-small.webp ${hero?600:compact?300:420}w, ${base+asset}.webp ${hero?1200:compact?600:840}w`} sizes={hero?'(max-width: 899px) 90vw, 50vw':compact?'(max-width: 699px) 100px, 220px':'(max-width: 699px) 90vw, (max-width: 1099px) 45vw, 25vw'} width={hero?1200:compact?600:840} height={hero?850:compact?360:460} alt="" loading={eager?'eager':'lazy'} fetchpriority={hero?'high':'auto'} decoding="async"/>}
</div>
