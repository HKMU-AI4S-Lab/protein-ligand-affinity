---
import {topics} from '../../data/research';
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.demo},props:{topic}}));}
const {topic}=Astro.props;
const to=import.meta.env.BASE_URL+'topics/'+topic.id+'/#experiment';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta http-equiv="refresh" content={'0;url='+to}/><title>{topic.analysisTitle}</title></head><body><a href={to}>{topic.analysisTitle} →</a></body></html>
