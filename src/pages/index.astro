---
import Layout from '../layouts/SiteLayout.astro';
import MethodIllustration from '../components/MethodIllustration.astro';
import {grantTitle,selectedResearch} from '../data/research';
import '../styles/home.css';
const base=import.meta.env.BASE_URL;
const methods=[
 {id:'representing-molecules',kind:'representations',method:'UniMolRep',title:'Explore a molecule',input:'A molecule as SMILES',output:'Fingerprints, atom graphs, geometry and spatial grids',action:'Explore representations',note:'Understand the structure a model sees.'},
 {id:'screening-molecules',kind:'screening',method:'DL-FSG',title:'Screen for a target',input:'SMILES and a protein target',output:'A relative screening score with Grad-CAM attribution.',action:'Screen a molecule',note:'Compare molecules within the same target.'},
 {id:'binding-affinity',kind:'binding-affinity',method:'GNINA / BAP',title:'Score a bound pose',input:'A PDB ID or your own protein–ligand complex',output:'A GNINA affinity estimate and pose score with spatial occlusion.',action:'Score a complex',note:'Choose the protein chains and bound ligand.'},
 {id:'protein-ligand-docking',kind:'docking',method:'ETDock',title:'Predict a binding pose',input:'A protein structure and a ligand',output:'A predicted three-dimensional ligand pose',action:'Explore docking',note:'Docking calculations are not yet available here.'}
] as const;
const steps=[
 {title:'Submit your input',text:'Choose a task and enter your molecule or complex.',icon:'M7 3h7l5 5v13H7z M14 3v6h5 M10 13h6 M10 17h6'},
 {title:'Explore the result',text:'Use the molecular views and concise score explanations.',icon:'M16.5 16.5 22 22 M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0'},
 {title:'Take it with you',text:'Download data, structures and a readable run summary.',icon:'M12 3v13 M7 11l5 5 5-5 M4 17v5h16v-5'},
 {title:'Go deeper',text:'Follow each method to the research behind it.',icon:'M3 5c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2z M12 7v15'}
];
---
<Layout description="Explore your own molecules and protein–ligand complexes. Generate representations, screen a target or score a bound pose, then download your results.">
<main id="main" class="wrap home-page">
 <section class="platform-intro" aria-labelledby="home-heading">
  <div class="hero-copy"><h1 id="home-heading">From molecular structure to binding affinity</h1><p class="hero-description">Explore molecular representations, screen against a protein target and score a bound pose using your own inputs. Discover how ETDock predicts binding poses, and connect each method to the research behind it.</p><a class="text-link editorial-link" href="#topics">Choose your task <span aria-hidden="true">↓</span></a></div>
  <div class="hero-art"><MethodIllustration kind="hero" eager/></div>
 </section>
 <section id="topics" class="task-section" aria-labelledby="tasks-heading">
  <div class="section-label"><h2 id="tasks-heading">Four methods, from molecules to complexes</h2></div>
  <div class="task-grid">{methods.map((method,i)=><article class="task-entry" data-method={method.kind}>
   <MethodIllustration kind={method.kind}/><p class="method-index method-label">0{i+1} / {method.method}</p><h3>{method.title}</h3>
   <dl><dt>Start with</dt><dd>{method.input}</dd><dt>Receive</dt><dd>{method.output}</dd></dl>
   <p class="method-note">{method.note}</p><a class="task-action editorial-link" href={base+'topics/'+method.id+'/'}>{method.action} <span aria-hidden="true">→</span></a>
  </article>)}</div>
 </section>
 <section class="journey-section" aria-labelledby="journey-heading">
  <h2 id="journey-heading">From input to insight</h2>
  <ol>{steps.map((step,i)=><li><div class="journey-mark"><svg viewBox="0 0 26 26" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={step.icon}/></svg><span>0{i+1}</span></div><strong>{step.title}</strong><span>{step.text}</span></li>)}</ol>
 </section>
 <section id="research" class="selected-research" aria-labelledby="research-heading">
  <div class="section-label"><h2 id="research-heading">Research on molecular structure and binding</h2><p class="research-introduction">Our research connects molecular representation with three questions: which compounds to prioritise, how they bind, and how strongly they may bind.</p></div>
  {selectedResearch.map(({work,kind,label,heading,summary,path,thumbnail})=><article class="selected-work" data-method={kind}>
   {thumbnail?<div class="method-illustration illustration-compact"><img src={base+thumbnail} width="180" height="132" alt={import.meta.env.PUBLIC_RELEASE==='true'?'Protein and ligand inputs guide binding-pose reconstruction.':'Protein–ligand pose detail from ETDock Figure 1.'} loading="lazy" decoding="async"/></div>:<MethodIllustration kind={kind} compact/>}
   <div class="selected-work-copy"><span class="publication-line method-label"><span>{label}</span><span>{work.id==='etdock'?'Online 2026 (2027 issue)':work.year}</span></span><h3><a href={base+path}>{heading}</a></h3><p>{summary}</p></div>
   <div class="research-links"><a class="editorial-link" href={base+path}>Explore {label} <span aria-hidden="true">→</span></a><a href={work.url}>Read the paper ↗</a></div>
  </article>)}
 </section>
 <section id="project" class="project-scope" aria-labelledby="project-title"><p class="project-label">Research project</p><div class="project-copy"><h2 id="project-title">{grantTitle}</h2><p>The project investigates how molecular grids and deep learning can improve the accuracy, interpretability and efficiency of protein–ligand affinity prediction. Its aim is to support structure-based drug design through better virtual screening and rescoring of protein–ligand poses.</p><p class="project-privacy">Calculations run in your browser. Molecules and uploaded complexes stay on your device; PDB lookups request the selected structure from the Protein Data Bank.</p></div></section>
</main></Layout>
