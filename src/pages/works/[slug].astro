---
import {researchWorks} from '../../data/research';
export function getStaticPaths(){return researchWorks.map(w=>({params:{slug:w.id},props:{topic:w.topic}}));}
const to=import.meta.env.BASE_URL+'topics/'+Astro.props.topic+'/';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta http-equiv="refresh" content={'0;url='+to}/><title>Read the research</title><link rel="canonical" href={new URL(to,Astro.site)}/></head><body><a href={to}>Read the research →</a></body></html>